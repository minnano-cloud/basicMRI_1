    {
      "library": "H5P.MultiChoice 1.16",
      "params": {
        "question": "<p>MRIのスピンエコー法で誤っているのはどれか。</p>",
        "answers": [
          {
            "text": "<div>最初に180度パルスが使われる。</div>",
            "correct": true,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>90度パルスは横磁化を作る。</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>長いTRと長いTEとではT2強調画像となる。</div>",
            "correct": false,
            "tipsAndFeedback": {
