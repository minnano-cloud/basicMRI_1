    {
      "library": "H5P.MultiChoice 1.16",
      "params": {
        "question": "<p>スピンエコー法の撮影時間を求める式として正しいのはどれか。<br>ただし、繰り返し時間はTR、エコー時間はTE、周波数エンコード数はN<sub>f</sub>、位相エンコード数はN<sub>p</sub>、加算回数はNEXとする。</p>",
        "answers": [
          {
            "text": "<div>TR × N<sub>f</sub> × NEX</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>TR × N<sub>p</sub> × NEX</div>",
            "correct": true,
            "tipsAndFeedback": {
              "tip": "",
